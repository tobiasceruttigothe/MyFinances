{
	"info": {
		"_postman_id": "myfinances-collection-001",
		"name": "MyFinances API",
		"description": "Colección completa para testear la API de MyFinances (gestión de finanzas personales/familiares).\n\nURLs via port-forward de K8s:\n- Gateway: http://localhost:8080\n- Keycloak: http://localhost:8082\n- Zipkin: http://localhost:9411\n\nFlujo sugerido:\n1. Login (auto-setea accessToken y userId)\n2. Usar cualquier endpoint autenticado",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "🔐 Auth",
			"description": "Autenticación y gestión de tokens",
			"item": [
				{
					"name": "Register (nuevo usuario)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"nuevo@test.com\",\n    \"username\": \"nuevo_usuario\",\n    \"password\": \"123456\",\n    \"firstName\": \"Nuevo\",\n    \"lastName\": \"Usuario\"\n}"
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/v1/users/register",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "v1", "users", "register"]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('userId', json.id);",
									"    pm.test('Usuario registrado correctamente', function() {",
									"        pm.expect(json.id).to.not.be.undefined;",
									"        pm.expect(json.email).to.eql('nuevo@test.com');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Login (usuario_prueba)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{testEmail}}\",\n    \"password\": \"{{testPassword}}\"\n}"
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/v1/users/login",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "v1", "users", "login"]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    pm.environment.set('accessToken', json.accessToken);",
									"    pm.environment.set('refreshToken', json.refreshToken);",
									"    pm.environment.set('userId', json.userId);",
									"    pm.test('Login exitoso', function() {",
									"        pm.expect(json.accessToken).to.not.be.empty;",
									"        pm.expect(json.userId).to.not.be.undefined;",
									"        pm.expect(json.tokenType).to.eql('Bearer');",
									"    });",
									"    console.log('Token guardado. UserId: ' + json.userId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Login (Keycloak directo)",
					"description": "Login directo contra Keycloak sin pasar por el gateway. Útil para debug.",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{ "key": "grant_type", "value": "password" },
								{ "key": "client_id", "value": "{{clientId}}" },
								{ "key": "username", "value": "{{testEmail}}" },
								{ "key": "password", "value": "{{testPassword}}" }
							]
						},
						"url": {
							"raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
							"host": ["{{keycloakUrl}}"],
							"path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    pm.environment.set('accessToken', json.access_token);",
									"    pm.environment.set('refreshToken', json.refresh_token);",
									"    // Decodificar JWT para extraer sub (userId)",
									"    var payload = JSON.parse(atob(json.access_token.split('.')[1]));",
									"    pm.environment.set('userId', payload.sub);",
									"    pm.test('Login Keycloak directo exitoso', function() {",
									"        pm.expect(json.access_token).to.not.be.empty;",
									"    });",
									"    console.log('Token guardado. Sub (userId): ' + payload.sub);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Refresh Token",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{gatewayUrl}}/api/v1/users/refresh-token",
							"host": ["{{gatewayUrl}}"],
							"path": ["api", "v1", "users", "refresh-token"]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    pm.environment.set('accessToken', json.access_token);",
									"    pm.environment.set('refreshToken', json.refresh_token);",
									"    pm.test('Token renovado', function() {",
									"        pm.expect(json.access_token).to.not.be.empty;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
